#include <SPI.h>
#include <MFRC522.h>

#define SS_PIN 10
#define RST_PIN 9

MFRC522 rfid(SS_PIN, RST_PIN);

void setup() {
  Serial.begin(115200);
  SPI.begin();
  rfid.PCD_Init();

  Serial.println("Reader Ready");
  Serial.print("Version: ");
  byte v = rfid.PCD_ReadRegister(rfid.VersionReg);
  Serial.println(v, HEX);
}

void loop() {
}
